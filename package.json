{
  "name": "video-editor",
  "version": "1.0.0",
  "description": "撮影素材から自動でカット・テロップ・BGM を付けて書き出す、デスクトップの動画編集アプリ",
  "main": "./out/main/index.js",
  "author": {
    "name": "VideoEditor",
    "url": "https://github.com/rymaruta/VideoEditor"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run test && electron-vite build && npm run licenses",
    "licenses": "node scripts/third-party-notices.mjs",
    "release-check": "node scripts/release-check.cjs",
    "gpl-sources": "node scripts/gpl-sources.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win:test": "npm run build && electron-builder --win --dir",
    "build:win": "node scripts/release-check.cjs && npm run build && electron-builder --win",
    "build:mac": "node scripts/release-check.cjs && electron-vite build && npm run licenses && electron-builder --mac",
    "build:linux": "node scripts/release-check.cjs && electron-vite build && npm run licenses && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "npm run lint && npm run build",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/klee-one": "^5.3.0",
    "@fontsource/kosugi-maru": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/rocknroll-one": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/yomogi": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "dotenv": "^16.6.1",
    "electron-updater": "6.8.10",
    "ffmpeg-static": "^5.3.0",
    "@derhuerst/ffprobe-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-llama-cpp": "^3.22.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright-core": "1.64.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  }
}
