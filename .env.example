# APIキーをここに書いて .env という名前で保存すると、アプリ起動時に自動で読み込まれます
# (このファイル自体は .env にリネームしないと読み込まれません。.env は .gitignore 済みです)
# アプリ内の設定欄で入力した値はこのファイルより優先されます。

# Gemini API キー (AIおまかせ全自動編集のAI採点/AIディレクター、投稿メタデータ生成、ゲームトレンド分析で使用)
GEMINI_API_KEY=

# YouTube Data API キー (YouTubeトレンド調査で使用)
YOUTUBE_API_KEY=

# Jamendo Client ID (BGMライブラリ検索で使用)
JAMENDO_CLIENT_ID=

# Freesound API キー (効果音ライブラリ検索で使用)
FREESOUND_API_KEY=
